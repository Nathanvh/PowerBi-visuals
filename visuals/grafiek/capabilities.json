          "displayName": "Hoekradius (px)",
          "type": {
            "numeric": true
          }
        },
        "labels": {
          "displayName": "Waarden tonen",
          "type": {
            "bool": true
          }
        },
        "mmss": {
          "displayName": "Waarden als m:ss (seconden)",
          "type": {
            "bool": true
          }
        },
        "notatie": {
          "displayName": "Notatie (leeg = formaat van het veld; bijv. 0, 0.0, #,0, 0%, m:ss)",
          "type": {
            "text": true
          }
        }
      }
    },
    "lijn": {
      "displayName": "Lijn",
