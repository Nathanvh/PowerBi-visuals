{
  "dataRoles": [
    {
      "displayName": "Categorie (as)",
      "name": "categorie",
      "kind": "Grouping"
    },
    {
      "displayName": "Kolommen (1 of meer measures)",
      "name": "waarden",
      "kind": "Measure"
