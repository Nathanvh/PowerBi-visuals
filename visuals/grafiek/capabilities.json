  "dataViewMappings": [
    {
      "conditions": [
        {
          "categorie": {
            "max": 1
          },
          "lijn": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "categorie"
          },
          "dataReductionAlgorithm": {
            "window": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "waarden"
              }
            },
            {
              "bind": {
                "to": "lijn"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": []
}